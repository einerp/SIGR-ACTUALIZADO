# Configuración del Servidor
PORT=3000

# Autenticación (usa valores propios y cambia la contraseña desde el dashboard)
# SESSION_SECRET debe ser aleatorio y tener mínimo 32 caracteres en producción.
SESSION_SECRET=cambia-este-secreto-por-una-cadena-aleatoria-de-minimo-32-caracteres
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123*

# Configuración de Supabase (Obtén estos valores en Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
SUPABASE_STORAGE_BUCKET=productos-imagenes

# Datos del Restaurante (aparecen en la factura POS)
RESTAURANT_NAME=SIGR Restaurante
RESTAURANT_NIT=900.123.456-7
RESTAURANT_ADDRESS=Calle Principal #123, Ciudad
RESTAURANT_PHONE=+57 300 000 0000
RESTAURANT_CURRENCY=COP
DEFAULT_TAX_RATE=8
