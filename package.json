{
  "name": "sigr-restaurante",
  "version": "1.0.0",
  "description": "SIGR - Sistema Integral de Gestión de Restaurantes con POS, Inventario, Clientes, Contabilidad y Reportes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --experimental-test-coverage tests/*.test.js",
    "lint": "eslint .",
    "build": "node scripts/build.js",
    "check": "npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2"
  }
}
